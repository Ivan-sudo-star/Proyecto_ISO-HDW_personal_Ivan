# /etc/network/interfaces — R3 Debian_NFtables
auto lo
iface lo inet loopback

# WAN: adaptador 1 (NAT de VirtualBox) -> IP per DHCP (10.0.2.15/24, GW 10.0.2.2, DNS 10.0.2.3)
allow-hotplug enp0s3
iface enp0s3 inet dhcp

# LAN: adaptador 2 (xarxa interna LAN13) — R3 és la .3 (R1 .1, R2 .2)
auto enp0s8
iface enp0s8 inet static
    address 192.168.13.3/24
